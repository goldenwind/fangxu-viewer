# Feedback and updates can reuse the product ID; their API addresses are configured separately.
# 0 disables membership and keeps the app in free-only mode.
VITE_MEMBERSHIP_PRODUCT_ID=0
VITE_MEMBERSHIP_API_BASE=https://x.ip21.cn

# 0 disables startup update checks. It normally uses the same product ID as membership.
VITE_UPDATE_PRODUCT_ID=0
VITE_UPDATE_API_BASE=https://api.ip21.cn
VITE_UPDATE_CHANNEL=stable

# Feedback page and submission API use api.ip21.cn, independently of membership.
VITE_FEEDBACK_API_BASE=https://api.ip21.cn
