{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "方序看图",
  "version": "0.1.0",
  "identifier": "com.fangxu.viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "方序看图",
      "width": 1200,
      "height": 800,
      "minWidth": 640,
      "minHeight": 480
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost http://asset.localhost data: blob: https://cdn.ip21.cn; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "dmg": {
        "windowSize": {
          "width": 600,
          "height": 360
        },
        "appPosition": {
          "x": 155,
          "y": 165
        },
        "applicationFolderPosition": {
          "x": 445,
          "y": 165
        }
      }
    }
  }
}

