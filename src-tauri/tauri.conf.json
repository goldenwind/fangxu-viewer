{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "方序看图",
  "mainBinaryName": "fangxu-viewer",
  "version": "0.1.2",
  "identifier": "com.fangxu.viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "方序看图",
      "width": 1200,
      "height": 800,
      "minWidth": 640,
      "minHeight": 480,
      "decorations": false,
      "transparent": true,
      "maximized": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost http://asset.localhost data: blob: https://cdn.ip21.cn; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*", "$HOME/**/*", "/Volumes/**/*", "/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg", "jpe", "jfif"],
        "name": "JPEG 图像",
        "description": "JPEG 图像文件",
        "role": "Editor",
        "mimeType": "image/jpeg"
      },
      {
        "ext": ["png", "apng"],
        "name": "PNG 图像",
        "description": "PNG 便携网络图形",
        "role": "Editor",
        "mimeType": "image/png"
      },
      {
        "ext": ["webp"],
        "name": "WebP 图像",
        "description": "WebP 图像文件",
        "role": "Editor",
        "mimeType": "image/webp"
      },
      {
        "ext": ["gif"],
        "name": "GIF 图像",
        "description": "GIF 动态图片",
        "role": "Editor",
        "mimeType": "image/gif"
      },
      {
        "ext": ["bmp", "dib"],
        "name": "BMP 位图",
        "description": "Windows 位图文件",
        "role": "Editor",
        "mimeType": "image/bmp"
      },
      {
        "ext": ["svg", "svgz"],
        "name": "SVG 矢量图",
        "description": "SVG 矢量图形",
        "role": "Editor",
        "mimeType": "image/svg+xml"
      },
      {
        "ext": ["avif"],
        "name": "AVIF 图像",
        "description": "AVIF 新一代图像",
        "role": "Editor",
        "mimeType": "image/avif"
      },
      {
        "ext": ["heic", "heif"],
        "name": "HEIC 图像",
        "description": "High Efficiency Image File",
        "role": "Editor",
        "mimeType": "image/heic"
      },
      {
        "ext": ["tiff", "tif"],
        "name": "TIFF 图像",
        "description": "Tagged Image File Format",
        "role": "Editor",
        "mimeType": "image/tiff"
      },
      {
        "ext": ["ico", "cur"],
        "name": "Windows 图标/光标",
        "description": "Windows Icon / Cursor",
        "role": "Editor",
        "mimeType": "image/x-icon"
      },
      {
        "ext": ["tga", "icb", "vda", "vst"],
        "name": "TGA 图像",
        "description": "Truevision Targa Graphic",
        "role": "Editor",
        "mimeType": "image/x-tga"
      },
      {
        "ext": ["hdr", "exr"],
        "name": "HDR/EXR 图像",
        "description": "High Dynamic Range Image",
        "role": "Editor",
        "mimeType": "image/vnd.radiance"
      },
      {
        "ext": ["dds"],
        "name": "DDS 纹理",
        "description": "DirectDraw Surface",
        "role": "Editor",
        "mimeType": "image/x-dds"
      },
      {
        "ext": ["qoi"],
        "name": "QOI 图像",
        "description": "Quite OK Image",
        "role": "Editor",
        "mimeType": "image/qoi"
      },
      {
        "ext": ["pnm", "pbm", "pgm", "ppm", "pam"],
        "name": "Netpbm 便携图像",
        "description": "Portable Any Map",
        "role": "Editor",
        "mimeType": "image/x-portable-anymap"
      },
      {
        "ext": ["ff"],
        "name": "farbfeld 图像",
        "description": "farbfeld 图像文件",
        "role": "Editor",
        "mimeType": "image/x-farbfeld"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "template": "nsis/installer.nsi",
        "languages": ["SimpChinese", "English"]
      }
    },
    "macOS": {
      "dmg": {
        "windowSize": {
          "width": 600,
          "height": 360
        },
        "appPosition": {
          "x": 155,
          "y": 165
        },
        "applicationFolderPosition": {
          "x": 445,
          "y": 165
        }
      }
    }
  }
}

